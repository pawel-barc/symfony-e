{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}

<div class="container mt-5">
    <h1>Créer un compte</h1>
    {# Affichage des erreurs globale du formulaire #}
    {% for flash_error in app.flashes('error') %}
        <div class="alert alert-danger">
            {{flash_error}}
        </div>
    {% endfor %}
    {# Affichage des messages globale du formulaire #}
    {% for flash_success in app.flashes('success') %}
        <div class="alert alert-success">
            {{flash_success}}
        </div>
    {% endfor %}        
    {{form_start(registerForm, {'attr': {'enctype': 'multipart/form-data', 'data-turbo': 'false' }})}}

        <div class="mb-3">
            {{ form_label(registerForm.firstname) }}
            {{ form_widget(registerForm.firstname, {'attr' : {'class' : 'form-control'}}) }}
            {{ form_errors(registerForm.firstname) }}
        </div>
        <div class="mb-3">
            {{ form_label(registerForm.lastname) }}
            {{ form_widget(registerForm.lastname, {'attr' : {'class' : 'form-control'}}) }}
            {{ form_errors(registerForm.lastname) }}
        </div>
        <div class="mb-3">
            {{ form_label(registerForm.username) }}
            {{ form_widget(registerForm.username, {'attr' : {'class' : 'form-control'}}) }}
            {{ form_errors(registerForm.username) }}
        </div>    
        <div class="mb-3">
            {{ form_label(registerForm.email) }}
            {{ form_widget(registerForm.email, {'attr' : {'class' : 'form-control'}}) }}
            {{ form_errors(registerForm.email) }}
        </div>
        <div class="mb-3">
            {{ form_label(registerForm.password) }}
            {{ form_widget(registerForm.password, {'attr' : {'class' : 'form-control'}}) }}
            {{ form_errors(registerForm.password) }}
        </div>
        <div class="mb-3">
            {{ form_label(registerForm.profileImage) }}
            {{ form_widget(registerForm.profileImage, {'attr' : {'class' : 'form-control'}}) }}
            {{ form_errors(registerForm.profileImage) }}
        </div>
        <div class="mb-3">
            {{ form_label(registerForm.bio) }}
            {{ form_widget(registerForm.bio, {'attr' : {'class' : 'form-control'}}) }}
            {{ form_errors(registerForm.bio) }}
        </div>   

        <button type="submit" class="btn btn-primary">S'inscrire</button>
    {{ form_end(registerForm) }}                 
</div>
{% endblock %}
