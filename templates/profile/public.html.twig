<div class="profile">
    <div class="profile-header">
        <div class="header-banner"></div>

        <div class="profile-info">
            {% if user.profileImage %}
                <img class="avatar" src="{{ asset('uploads/profile_images/' ~ user.profileImage) }}" alt="Photo de profil de {{ user.username }}">
            {% else %}
                <div class="avatar default-avatar">B</div>
            {% endif %}

            {% if app.user and app.user.id == user.id %}
                <a href="{{ path('app_profile_edit') }}" class="edit-btn">Modifier mon profil</a>
            {% elseif app.user and app.user != user %}
                {% set isFollowing = user.isFollowedBy(app.user) %}
                {% set followback = app.user.isFollowedBy(user) %}
                <button class="follow-btn {{ isFollowing ? 'following' : '' }}"
                        data-username="{{ user.username }}"
                        data-following="{{ isFollowing ? '1' : '0' }}">
                    {{ isFollowing ? (followback ? '↔ Suivi' : 'Suivi') : 'Suivre' }}
                </button>
            {% endif %}

            <h2>{{ user.firstname }} {{ user.lastname }}</h2>
            <p class="username">@{{ user.username }}</p>
            <p class="created">À rejoint Twitter depuis le {{ user.createdAt|date('m/Y') }}</p>
            <p class="follow-stats">
                <a href="{{ path('user_following', { username: user.username }) }}">
                    <strong>{{ user.getFollows()|length }}</strong> Abonnements
                </a>
                <a href="{{ path('user_followers', { username: user.username }) }}">
                    <strong>{{ user.getFollowers()|length }}</strong> Abonnés
                </a>
            </p>
        </div>
    </div>

    <div id="posts-list">
        {% if timeline is empty %}
            <p style="color:#71767b">Aucun post ou retweet pour le moment</p>
        {% else %}
            {% for item in timeline %}
                {% include 'post/_post_item.html.twig' with {
                    post: item.data,
                    profile_user: user,
                    type: item.type,
                    item: item
                } %}
            {% endfor %}

        {% endif %}
    </div>
</div>

<script src="{{ asset('js/follow.js') }}"></script>
