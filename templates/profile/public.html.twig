{% extends 'base.html.twig' %}

{% block title %} Profil de {{ user.username }} {% endblock %}

{% block body %}
{# Affichage des données personnelles de l'utilisateur, y compris ces publications et abonnements #}
    <div>
        <h2>{{ user.firstname }} {{ user.lastname }}</h2>
        <p>{{ user.getPosts|length }} posts</p>
        {% if user.profileImage %}
            <img src="{{ asset('uploads/profile_images/' ~ user.profileImage) }}" alt="Photo de profil de {{user.username}}"><br>
        {% endif %}
        {% if app.user and app.user != user %}
            {% set isFollowing = user.isFollowedBy(app.user) %}
            {% set followback = app.user.isFollowedBy(user) %}
            <button class="follow-btn" 
                data-username="{{ user.username }}" data-following="{{ isFollowing ? '1' : '0'}}">{{ isFollowing ? (followback ? '↔ Suivi' : 'Suivi') : 'Suivre'}}
            </button><br>
        {% endif %}
        <h2>{{ user.firstname}} {{ user.lastname }}</h2>
        <p>{{ user.username}}</p>
        <p>{{ user.bio }}</p>
        <p>Inscrit le {{ user.createdAt|date('d/m/Y') }}</p>
        <p>
            <a href="{{ path('user_following', { username:  user.username }) }}">
                <strong>{{ user.getFollows()|length }}</strong> abonnements
            </a>
            <a href="{{ path('user_followers', { username:  user.username }) }}">                            
                <strong>{{ user.getFollowers()|length }}</strong> abonnés
            </a>    
        </p>
        <hr>
        {# Affichage des publications avec le format approprié #}    
        <h3>Publications</h3>
        {% for post in user.posts %}
            <div>
                {% if post.text %}
                    <p>{{ post.text }}</p>
                {% endif %}
                
                {% if post.image %}
                    <img src="{{asset('/uploads/' ~ post.image) }}" alt="image">
                {% endif %}
                
                {% if post.video %}
                    <video controls>
                        <source src="{{asset('uploads/' ~ post.video) }}" type="video/mp4">
                    </video>
                {% endif %}    
                <small>{{ post.createdAt|date('d/m/Y H:i') }}</small>
            </div>
        {% else %}
            <p>Aucun post pour le moment</p>
        {% endfor %}
    </div>
<script src="{{ asset('js/follow.js') }}"></script>
{% endblock %}        