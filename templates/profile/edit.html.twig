{% extends 'base.html.twig' %}

{% block title %}Modifier le profil{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/register.css') }}">
{% endblock %}

{% block body %}
    <div class="register-container">
        <h1>Modifier mon profil</h1>

        {# Flash messages #}
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ type == 'success' ? 'success' : 'danger' }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        {# Image actuelle #}
        {% if app.user.profileImage %}
            <div class="form-group full-width">
                <img src="{{ asset('uploads/profile_images/' ~ app.user.profileImage) }}" style="max-width:120px;border-radius:50%;margin-top:10px;"/>
            </div>
        {% endif %}

        {{ form_start(profileForm, {'attr': {'enctype': 'multipart/form-data', 'data-turbo': 'false'}}) }}

        <div class="form-group">
            {{ form_label(profileForm.firstname) }}
            {{ form_widget(profileForm.firstname, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(profileForm.firstname) }}
        </div>

        <div class="form-group">
            {{ form_label(profileForm.lastname) }}
            {{ form_widget(profileForm.lastname, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(profileForm.lastname) }}
        </div>

        <div class="form-group">
            {{ form_label(profileForm.username) }}
            {{ form_widget(profileForm.username, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(profileForm.username) }}
        </div>

        <div class="form-group">
            {{ form_label(profileForm.email) }}
            {{ form_widget(profileForm.email, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(profileForm.email) }}
        </div>

        <div class="form-group">
            {{ form_label(profileForm.password) }}
            {{ form_widget(profileForm.password, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(profileForm.password) }}
        </div>

        <div class="form-group">
            {{ form_label(profileForm.profileImage) }}
            {{ form_widget(profileForm.profileImage, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(profileForm.profileImage) }}
        </div>

        <div class="form-group full-width">
            {{ form_label(profileForm.bio) }}
            {{ form_widget(profileForm.bio, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(profileForm.bio) }}
        </div>

        <div class="form-actions">
            <a href="{{ path('app_user_profile', { username: app.user.username }) }}" class="cancel-btn">Annuler</a>
            <button type="submit">Mettre à jour</button>
        </div>

        {{ form_end(profileForm) }}
    </div>
{% endblock %}
