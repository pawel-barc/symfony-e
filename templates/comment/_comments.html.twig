<div class="comments-section">
    <h3>Commentaires</h3>

    {% for comment in comments|filter(comment => comment.parentComment is null) %}
        <div class="comment-thread">
            {{ include('comment/_comment_item.html.twig', { 'comment': comment, 'depth': 0 }) }}
        </div>
    {% else %}
        <p>Aucun commentaire pour le moment.</p>
    {% endfor %}
</div>
