{% extends 'base.html.twig' %}

{% block title %}Liste des hashtags{% endblock %}

{% block body %}
    <h1 class="mb-4">📢 Tous les Hashtags</h1>


    {% if hashtags is empty %}
        <p>Aucun hashtag a été créé.</p>
    {% else %}
        <ul>
            {% for hashtag in hashtags %}
                <li>#{{ hashtag.name }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
