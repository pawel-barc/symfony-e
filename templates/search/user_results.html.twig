{% extends 'base.html.twig' %}

{% block title %}Résultats de recherche{% endblock %}
{# Affichage des résultats de la recherche d'utilisateurs et liens vers leurs profils publics #}
{% block body %}
    <h1>Résultats pour "{{query}}"</h1>

    {% if users is not empty %}
        <ul>
            {% for user in users %}
                <li>{{ user.username }} - <a href="{{path('app_user_profile', {'username': user.username}) }}">Voir le profil</a></li>
            {% endfor %}
        </ul>
    {% else %}
        <p>Aucun utilisateur trouvé</p>
    {% endif %}            
{% endblock %}
