{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/navbar.css') }}">
    <link rel="stylesheet" href="{{ asset('css/feed.css') }}">
{% endblock %}

{% block title %}Accueil{% endblock %}

{% block body %}
    <div class="feed-container">
        <div class="feed-main">
            <div class="feed-tabs">
                <div class="tab active">Pour vous</div>
                <div class="tab">Abonnements</div>
            </div>

            <div class="feed-post-box">
                <div class="profile-picture">Image Profil</div>
                <div class="post-content">
                    <form method="post" action="{{ path('app_post') }}">
                        <textarea class="post-input" name="content" placeholder="Tweeter..."></textarea>
                        <div class="post-actions">
                            <svg width="30px" height="30px" viewBox="0 0 24 24" fill="#1DA1F2" xmlns="http://www.w3.org/2000/svg">
                            </svg>
                            <button type="submit" class="post-button">Poster</button>
                        </div>
                    </form>
                </div>
            </div>

            <div>
                <h2>Publications</h2>
                {% for post in posts %}
                    <div class="post">
                        <p>{{ post.text }}</p>
                        <small>Posté par {{ post.author.username }} le {{ post.createdAt|date('d/m/Y H:i') }}</small>
                        <a href="{{ path('post_show', { id: post.id }) }}">Voir le post</a>
                    </div>
                {% else %}
                    <p>Aucune publication.</p>
                {% endfor %}

                <h2>Commentaires</h2>
                {% for comment in comments %}
                    <div class="comment">
                        <p>{{ comment.content }}</p>
                        <small>Commenté par {{ comment.user.username }} le {{ comment.createdAt|date('d/m/Y H:i') }}</small>
                    </div>
                {% else %}
                    <p>Aucun commentaire.</p>
                {% endfor %}
            </div>
        </div>

        <div class="feed-sidebar">
            <div class="search-bar">
                <input type="text" placeholder="Rechercher..." />
            </div>
            <div class="trending">Tendances</div>
            <div class="suggestions">Amis suggérés</div>
        </div>
    </div>
{% endblock %}
