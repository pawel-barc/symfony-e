<div id="feed-list">
    <button id="reload-feed-btn">Recharger mon feed</button>
    <div id="posts-list">
        {% for item in timeline %}
            {% if item.type == 'repost' %}
                {% include 'post/_post_item.html.twig' with {
                    post: item.data,
                    profile_user: item.user,
                    type: 'repost',
                    item: item
                } %}
            {% else %}
                {% include 'post/_post_item.html.twig' with {
                    post: item.data,
                    profile_user: item.data.author,
                    type: 'post'
                } %}
            {% endif %}
        {% else %}
            <p>Aucune publication.</p>
        {% endfor %}
    </div>
</div>
