{% extends 'base.html.twig' %}
    {% block title %} Notifications {% endblock %}
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('css/notification.css') }}">
    {% endblock %}    
    {% block body %}
    <div class="notification-container">
        {% include 'navbar/index.html.twig' %}
        <div class="notification-child">
            <h1 class="not-title">Notifications</h1><br>
            <ul>
                {% for notification in notifications %}    
                    <li class="{{ notification.isRead ? 'read' : 'unread' }}"><hr>
                        <a class="not-link" href="{{ path('app_notification_read', {id: notification.id}) }}">
                            <div class="list-item">
                                <h4 class="item-title">{{ notification.type[0]|capitalize }}</h4><h4 class="item-title"> Interaction de</h4> <h4 class="item-title">{{ notification.sender.username }}</h4>
                                <small>({{ notification.createdAt|date('Y-m-d H:i') }})</small>
                            </div>
                        </a>
                    </li>
                {% else %}
                    <li>Pas de notifications</li>
                {% endfor %}
            </ul>
        </div>
    </div>
{% endblock %}
